cat > .gitignore << 'EOF'
# Virtual environment
fedmu_env/
venv/
.env

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Data (too large for git — use git-lfs or external storage)
data/mimic_cxr/
data/chexpert/
*.jpg
*.jpeg
*.png
*.dcm
*.csv

# Model checkpoints (large files)
models/checkpoints/
*.pt
*.pth
*.safetensors
*.bin

# Logs and outputs
logs/
runs/
*.log
wandb/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Secrets
*.env
secrets.yaml
EOF